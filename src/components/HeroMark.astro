---
// The hero's right-side visual: a dog travels the same rising route the text
// chips describe (stradă → tratament → sterilizare → familie), arriving at a
// small house — literal and warm, replacing an earlier, more abstract "route
// dial" version, then two hand-drawn dog marks (full-body, then face-only).
// The traveling figure is now the Google Noto Emoji "Dog Face" (🐶), per
// client request — see src/assets/emoji/NOTICE.md for source/license.
//
// The run uses native SVG <animateMotion>/<mpath> rather than CSS
// offset-path: offset-path's coordinate space inside a scaled SVG viewBox is
// unreliable across the CSS/SVG boundary, while animateMotion is evaluated
// natively in the SVG's own user-unit space and lands exactly on the path.
// Ends just short of the house (at its doorstep, ~390,145) rather than at
// its center, so the resting dog sits in front of the door instead of
// overlapping the roof.
const routePath =
  "M 66 372 C 110 330, 130 300, 168 274 C 210 246, 250 220, 280 190 C 320 150, 355 148, 388 145";
---

<div class="hero-mark hidden lg:block" aria-hidden="true">
  <svg viewBox="0 0 480 480" class="h-full w-full">
    <defs>
      <path id="hero-route-path" d={routePath} />
    </defs>

    <circle cx="400" cy="128" r="112" fill="none" stroke="var(--color-blue)" stroke-opacity="0.18" stroke-width="1.5" />
    <circle cx="400" cy="128" r="82" fill="none" stroke="var(--color-pink)" stroke-opacity="0.22" stroke-width="1.5" />

    <use href="#hero-route-path" fill="none" stroke="var(--color-ink)" stroke-opacity="0.3" stroke-width="2.5" stroke-dasharray="2 9" stroke-linecap="round" class="hero-mark-path" />

    <circle cx="66" cy="372" r="7" fill="var(--color-ink)" class="hero-mark-pop" style="--n-delay: 0ms;" />

    <!-- House: "familie nouă" — outer <g> holds static position/scale (an SVG
         attribute), inner <g> takes the CSS pop-in animation, so the two
         transforms don't fight over the same element. -->
    <g transform="translate(350 78) scale(1.35)">
      <g class="hero-mark-pop" style="--n-delay: 300ms;">
        <path d="M 2,26 L 30,3 L 58,26 Z" fill="var(--color-green)" />
        <rect x="8" y="26" width="44" height="30" rx="2.5" fill="var(--color-green)" />
        <rect x="16" y="34" width="9" height="9" rx="1.5" fill="var(--color-cream)" />
        <rect x="25.5" y="36" width="9" height="20" rx="1.5" fill="var(--color-cream)" />
      </g>
    </g>

    <!-- Dog: travels the route once per loop, arrives, rests near the house,
         restarts. The Google Noto Emoji "Dog Face" (🐶, U+1F436), inlined —
         see src/assets/emoji/NOTICE.md for source and license (OFL-1.1) —
         replacing the earlier hand-drawn marks (an abstract route dial, then
         a hand-authored running silhouette, then a hand-authored face). -->
    <g class="hero-mark-dog" opacity="0">
      <animateMotion dur="7s" begin="1.6s" repeatCount="indefinite" keyPoints="0;0;1;1;0" keyTimes="0;0.06;0.78;0.92;1" calcMode="linear">
        <mpath href="#hero-route-path" />
      </animateMotion>
      <animate attributeName="opacity" dur="7s" begin="1.6s" repeatCount="indefinite" values="0;1;1;1;0" keyTimes="0;0.06;0.78;0.92;1" calcMode="linear" />

      <!-- Static scale (SVG attribute) on the outer group; the pulse
           (CSS-free SMIL animateTransform) lives on the inner group with no
           static transform of its own, so the two never fight. The
           innermost group recenters the emoji's own 0-128 box on its
           visual center (64,64), so both the scale and the pulse originate
           from the dog's center rather than its top-left corner. -->
      <g transform="scale(0.5)">
        <g>
          <animateTransform attributeName="transform" type="scale" values="1;1.08;1" keyTimes="0;0.5;1" dur="0.45s" begin="1.6s" repeatCount="indefinite" additive="sum" />
          <g transform="translate(-64 -64)">
            <path fill="#FFEAC8" d="M63.76,19.97c-29.09-0.75-38.51,21.77-39.23,30.22c-0.56,6.57-3.38,30.6,10.32,46.74c7.07,8.33,18.4,12.48,30.41,12.2c12.11-0.28,23.05-2.69,30.41-12.39c12.39-16.33,11.07-40.73,9.39-48.62C103.48,40.78,97.35,20.83,63.76,19.97z" />
            <path fill="#D27856" d="M96.82,64.43c1.03,7.81-2.36,15.26-11.29,15.79c-8.17,0.49-13.21-4.72-13.61-12.39c-0.41-7.86,3.89-15.17,10.72-15.92C89.85,51.12,95.8,56.62,96.82,64.43z" />
            <path fill="#D27856" d="M18.9,26.72c0,0-9.83,3.85-12.2,9.57c-3.19,7.7-1.72,22.98,0,28.91c1.69,5.82,6.19,11.83,13.14,11.64s13.05-7.23,15.2-16.42c2.16-9.2,2.63-24.96,3.28-27.78s1.78-5.07,1.78-5.07S31.47,19.21,18.9,26.72z" />
            <path fill="#D27856" d="M101.21,25.5c0,0,13.33,0.47,16.52,1.88s6.1,7.79,5.82,16.33s-0.84,22.35-5.16,27.12c-3.57,3.94-10.79,4.22-14.83-0.66s-6.57-13.14-7.51-18.49c-0.94-5.35-2.53-12.29-3.57-15.39c-1.03-3.1-3.57-9.29-4.88-10.7C86.28,24.19,88.91,22.87,101.21,25.5z" />
            <path fill="#865B51" d="M29.97,22.31c-7.23-0.46-19.15,5.26-21.59,11.17S7.37,58.57,9.42,64.17c2.16,5.91,6.66,13.33,14.45,6.95s9.85-22.43,10.61-27.59c0.75-5.16,1.78-11.45,2.91-12.76c1.13-1.31,2.72-3.19,2.72-3.19S38.89,22.87,29.97,22.31z" />
            <path fill="#865B51" d="M102.8,21.09c6.79,0.47,14.17,3,16.89,8.92c2.72,5.91,1.69,19.9,0.66,26.56s-3.47,13.61-9.57,12.86c-6.1-0.75-9.2-9.01-11.07-16.8c-1.88-7.79-3.85-15.58-6.29-21.21c-1.47-3.4-6.57-5.91-6.57-5.91S89.1,20.15,102.8,21.09z" />
            <path fill="#2F2F2F" d="M50.5,67.69c-0.4,3.42-2.16,6.18-5.98,5.78c-2.71-0.29-4.53-3.52-4.13-6.95c0.4-3.42,1.59-5.88,4.79-5.82C50.15,60.79,50.9,64.26,50.5,67.69z" />
            <path fill="#2F2F2F" d="M89.74,66.73c0.16,3.44-1.2,6.38-5.17,6.67c-3.45,0.25-5.22-2.74-5.37-6.18c-0.16-3.44,1.55-6.2,4.84-6.61C88.31,60.06,89.58,63.29,89.74,66.73z" />
            <path fill="#2F2F2F" d="M75.12,84.07c0.16,3.44-2.16,6.66-9.39,6.57c-7.04-0.09-9.6-2.94-9.76-6.38c-0.16-3.44,3.84-6.53,9.57-6.66C73.43,77.4,74.96,80.62,75.12,84.07z" />
            <path fill="#E94B8C" d="M59.16,97.96c0,0,0.85,8.17,1.69,10.61c1.78,5.16,9.28,4.3,10.61-0.56c1.13-4.13,0.38-11.26,0.38-11.26l-6.66-0.94L59.16,97.96z" />
            <path fill="#EF87B2" d="M65.96,100.68c-1.17,0.05-1.13,1.13-1.13,3.61c0,2.49,0.14,3.99,1.27,3.94c1.13-0.05,0.99-1.97,0.99-3.75S67.18,100.63,65.96,100.68z" />
            <path fill="#2F2F30" d="M50.15,90.21c-1.35,1.99,1.27,3.75,3.43,5.21c2.16,1.45,4.78,3.66,7.88,3.61c3.47-0.05,4.41-2.39,4.41-2.39s1.13,2.77,6.05,2.25c2.63-0.28,5.87-3.23,6.85-3.89c1.88-1.27,4.13-2.86,3.14-4.18c-1.13-1.51-3.52,0.52-5.96,1.78c-2.44,1.27-3.28,1.88-5.11,1.88s-3.1-0.75-3.19-3.8c-0.08-2.49-0.05-2.96-0.05-2.96h-4.18c0,0,0.14,2.63,0.14,3.38c0,1.97-1.03,2.82-3,2.91c-1.97,0.09-4.08-1.55-5.12-2.16C54.42,91.25,51.23,88.62,50.15,90.21z" />
          </g>
        </g>
      </g>
    </g>
  </svg>
</div>

<style>
  .hero-mark {
    width: 100%;
    max-width: 420px;
    aspect-ratio: 1;
    margin-inline: auto;
    animation: hero-mark-in 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 0.15s;
  }

  .hero-mark-path {
    stroke-dasharray: 480;
    stroke-dashoffset: 480;
    animation: hero-mark-draw 1.4s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 0.3s;
  }

  .hero-mark-pop {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: hero-mark-pop-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(0.5s + var(--n-delay));
  }

  @keyframes hero-mark-in {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes hero-mark-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes hero-mark-pop-in {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-mark,
    .hero-mark-path,
    .hero-mark-pop {
      animation: none;
      opacity: 1;
      stroke-dashoffset: 0;
      transform: none;
    }
  }
</style>

<script>
  // SMIL (<animateMotion>/<animate>/<animateTransform>) ignores the CSS
  // reduced-motion rule above, since it isn't a CSS animation. Pausing it
  // (SVGSVGElement.pauseAnimations()) isn't enough on its own: a paused
  // animation element still owns its target attribute and overrides any
  // setAttribute() call on the same attribute. Remove the animation
  // elements outright instead, which hands the attribute back, then set
  // the resting state explicitly.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (reduceMotion) {
    document.querySelectorAll<SVGSVGElement>(".hero-mark svg").forEach((svg) => {
      svg.pauseAnimations();
      const dog = svg.querySelector<SVGGElement>(".hero-mark-dog");
      dog?.querySelectorAll("animateMotion, animate, animateTransform").forEach((el) => el.remove());
      dog?.setAttribute("opacity", "1");
      dog?.setAttribute("transform", "translate(388, 145)");
    });
  }
</script>
