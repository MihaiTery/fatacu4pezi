---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import HeroChase from "../components/HeroChase.astro";
import { site } from "../data/config";

const stops = ["Sesizare", "Preluare", "Sterilizare", "Îngrijire", "Foster", "Adopție"];
---

<Layout
  title={site.name}
  seoTitle="Salvare, tratament veterinar și sterilizare animale de pe stradă | Fata cu 4pezi"
  description="Fata cu 4pezi intervine, în limita resurselor disponibile, pentru salvarea, tratamentul veterinar, sterilizarea, găsirea unui foster și adopția animalelor de pe străzi, pe tot teritoriul României."
>
  <div class="flex min-h-screen flex-col">
    <SiteHeader />

    <main id="main" class="flex-1">
      <!-- Hero -->
      <section class="mx-auto grid max-w-7xl gap-10 px-4 pb-16 pt-14 sm:px-6 sm:pt-20 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-6 lg:px-8">
        <div>
          <h1 class="font-black text-[2.6rem] leading-[1.08] text-ink sm:text-6xl">
            Pentru animalele de pe străzi, fiecare secundă contează!
          </h1>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">
            Fata cu 4pezi intervine, în limita resurselor disponibile, pentru salvarea, tratamentul veterinar, sterilizarea, găsirea unui foster și adopția animalelor de pe străzi.
          </p>
          <p class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-ink-soft">
            <Icon name="map-pin" class="h-4 w-4 text-ink/50" aria-hidden="true" />
            România
          </p>

          <div
            class="mt-8 flex max-w-2xl flex-wrap items-center gap-x-2 gap-y-3 text-sm font-medium text-ink-soft"
            aria-label="Traseul unui animal salvat, de la stradă la familie"
          >
            {
              stops.map((stop, i) => (
                <>
                  <span class="inline-flex items-center gap-2 rounded-full border border-ink/15 bg-paper px-3.5 py-1.5">
                    <span class="h-1.5 w-1.5 rounded-full bg-green" aria-hidden="true" />
                    {stop}
                  </span>
                  {i < stops.length - 1 && (
                    <Icon name="arrow-right" class="h-4 w-4 shrink-0 text-ink/30" aria-hidden="true" />
                  )}
                </>
              ))
            }
          </div>

          <div class="mt-10 flex flex-wrap items-center gap-3">
            <Button href="/doneaza" variant="primary" size="lg">Donează</Button>
            <Button href="/redirectioneaza" variant="outline" size="lg">Redirecționează 3,5%</Button>
          </div>
        </div>

        <HeroChase />
      </section>
    </main>

    <SiteFooter />
  </div>
</Layout>
