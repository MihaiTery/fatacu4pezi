---
import PageLayout from "../../layouts/PageLayout.astro";
import PartnerCard from "../../components/PartnerCard.astro";
import Button from "../../components/Button.astro";
import Icon from "../../components/Icon.astro";
import { getCollection } from "astro:content";
import { contact } from "../../data/config";

const partners = (await getCollection("partners")).sort(
  (a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0)
);
---

<PageLayout
  title="Parteneri"
  description="Clinicile veterinare, furnizorii și organizațiile care fac posibilă, alături de Fata cu 4pezi, salvarea și tratarea animalelor din București și Ilfov."
  intro="Fiecare intervenție reușită are, aproape mereu, un partener în spate — un cabinet veterinar, un furnizor, un voluntar de foster. Iată rețeaua noastră."
>
  <section class="mx-auto max-w-4xl px-4 pb-20 pt-2 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-5">
      {
        partners.map((partner, i) => (
          <div data-reveal style={`--reveal-delay: ${Math.min(i, 4) * 80}`}>
            <PartnerCard partner={partner} />
          </div>
        ))
      }
    </div>

    <div class="card-lift mt-14 rounded-2xl border border-ink/10 bg-paper p-7" data-reveal>
      <h2 class="font-display text-xl font-bold text-ink">Vrei să devii partener?</h2>
      <p class="mt-2 max-w-xl text-sm leading-relaxed text-ink-soft">
        Colaborăm mai ales cu clinici și cabinete veterinare, dar suntem deschiși oricărei forme de sprijin constant —
        materiale, logistică, găzduire temporară sau expertiză. Scrie-ne și povestește-ne cum ai putea contribui.
      </p>
      <Button href={`mailto:${contact.email}?subject=${encodeURIComponent("Propunere de parteneriat")}`} variant="outline" size="sm" class="mt-4">
        Contactează-ne
        <Icon name="arrow-right" class="h-4 w-4" />
      </Button>
    </div>
  </section>
</PageLayout>
