---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
---

<Layout title="Pagina nu a fost găsită" description="Pagina căutată nu există." noindex>
  <div class="flex min-h-screen flex-col">
    <SiteHeader />
    <main id="main" class="flex flex-1 items-center">
      <div class="mx-auto max-w-xl px-4 py-24 text-center sm:px-6 lg:px-8">
        <p class="font-display text-6xl font-bold text-ink/20">404</p>
        <h1 class="mt-4 font-display text-2xl font-bold text-ink">Pagina nu a fost găsită</h1>
        <p class="mt-3 text-ink-soft">Linkul poate fi vechi sau greșit scris. Iată câteva locuri utile:</p>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <Button href="/" variant="primary" size="md">Acasă</Button>
          <Button href="/adopta" variant="outline" size="md">
            Adoptă
            <Icon name="arrow-right" class="h-4 w-4" />
          </Button>
          <Button href="/fa-o-sesizare" variant="outline" size="md">
            Fă o sesizare
            <Icon name="arrow-right" class="h-4 w-4" />
          </Button>
        </div>
      </div>
    </main>
    <SiteFooter />
  </div>
</Layout>
