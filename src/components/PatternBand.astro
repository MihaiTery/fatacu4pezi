---
// A full-bleed, text-free strip of the client's illustrated animal pattern,
// used as a breather between sections of a long page. Purely decorative —
// hidden from assistive tech, carries no content. Full-strength ink lines on
// cream (the designer's cream/maro colorway), so it reads as illustration,
// never as a texture behind text. Repeats horizontally only, so the strip
// shows one clean row of the tile (bag cat, yarn, turtle, hamster, lying
// cat) instead of half-cut animals wrapping in from the row above.
interface Props {
  class?: string;
  offset?: string;
}

const { class: className, offset = "-40px 12px" } = Astro.props;
---

<div
  class:list={["bg-animals h-28 bg-cream [--animals-ink:var(--color-ink)] [--animals-size:260px] [--animals-repeat:repeat-x]", className]}
  style={`--animals-offset: ${offset}`}
  aria-hidden="true"
>
</div>
