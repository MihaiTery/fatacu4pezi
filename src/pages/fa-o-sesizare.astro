---
import PageLayout from "../layouts/PageLayout.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import { contact } from "../data/config";
import { withBase } from "../lib/url";

const checklist = [
  {
    title: "Locația cât mai exactă",
    text: "O adresă, o intersecție, un reper vizibil sau, ideal, coordonate GPS din telefon.",
  },
  {
    title: "Câteva fotografii",
    text: "Ne ajută să estimăm starea animalului înainte să ajungem la fața locului.",
  },
  {
    title: "Ce ai observat",
    text: "De cât timp este acolo, dacă pare rănit, speriat, foarte tânăr sau are un comportament neobișnuit.",
  },
  {
    title: "Datele tale de contact",
    text: "Un număr de telefon sau e-mail la care să revenim, dacă avem nevoie de clarificări.",
  },
];

const subject = encodeURIComponent("Sesizare — animal în dificultate");
const body = encodeURIComponent(
  `Locație (adresă / reper / coordonate GPS):\n\nCe ai observat:\n\nDe cât timp este acolo:\n\nFotografii atașate: da / nu\n\nDatele tale de contact:\n`
);
const mailtoHref = `mailto:${contact.reportEmail}?subject=${subject}&body=${body}`;
---

<PageLayout
  title="Fă o sesizare"
  description="Ai găsit un animal în dificultate în București sau Ilfov? Iată ce informații ne ajută să intervenim rapid."
  intro="Dacă ai găsit un animal în dificultate în București sau Ilfov, spune-ne. Cu cât sesizarea este mai completă, cu atât putem răspunde mai rapid."
>
  <section class="mx-auto max-w-5xl px-4 pb-20 pt-2 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[1fr_320px]">
      <div>
        <h2 class="font-display text-xl font-bold text-ink">Ce ne ajută să pregătim înainte să scrii</h2>
        <ul class="mt-6 flex flex-col gap-6">
          {
            checklist.map((item, i) => (
              <li class="flex gap-4">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border-2 border-ink/25 font-display text-sm font-bold text-ink">
                  {i + 1}
                </span>
                <div>
                  <p class="font-semibold text-ink">{item.title}</p>
                  <p class="mt-1 text-sm leading-relaxed text-ink-soft">{item.text}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <p class="mt-10 max-w-xl text-sm leading-relaxed text-ink-soft">
          Nu este nevoie să ai toate informațiile ca să ne scrii — trimite ce ai, iar noi revenim cu întrebări dacă e nevoie.
          Pentru context suplimentar, poți citi și{" "}
          <a href={withBase("/blog/ce-faci-daca-gasesti-un-animal-ranit-pe-strada")} class="font-semibold text-ink underline decoration-ink/30 hover:decoration-ink">
            ghidul nostru despre ce faci când găsești un animal rănit
          </a>.
        </p>
      </div>

      <aside class="h-fit rounded-2xl border border-ink/10 bg-paper p-6">
        <h2 class="font-display text-lg font-bold text-ink">Trimite sesizarea</h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">
          Se deschide clientul tău de e-mail, cu un model completat pe care îl poți edita înainte de a trimite.
        </p>
        <Button href={mailtoHref} variant="primary" size="md" class="mt-5 w-full">
          <Icon name="mail" class="h-4 w-4" />
          Trimite un e-mail
        </Button>
        <p class="mt-3 text-xs text-ink-soft">{contact.reportEmail}</p>
      </aside>
    </div>
  </section>
</PageLayout>
