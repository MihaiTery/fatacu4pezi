---
import PageLayout from "../../layouts/PageLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getCollection } from "astro:content";

const articles = (await getCollection("blog")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<PageLayout
  title="Ghiduri și resurse pentru animale"
  seoTitle="Ghiduri despre salvarea și adopția animalelor | Fata cu 4pezi"
  description="Citește ghidurile Fata cu 4pezi despre salvarea animalelor, adopție responsabilă, sterilizare și îngrijire. Informații utile pentru iubitorii de animale."
  intro="Informații practice despre salvare, îngrijire și adopție responsabilă. Află cum poți ajuta animalele aflate în dificultate și cum te poți pregăti pentru adopție."
>
  <section class="mx-auto max-w-7xl px-4 pb-20 pt-2 sm:px-6 lg:px-8">
    {
      articles.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {articles.map((article, i) => (
            <div data-reveal style={`--reveal-delay: ${i * 100}`}>
              <ArticleCard article={article} />
            </div>
          ))}
        </div>
      ) : (
        <p class="max-w-xl rounded-2xl border border-ink/10 bg-paper p-6 text-sm leading-relaxed text-ink-soft">
          Primele articole apar în curând. Până atunci, poți urmări cazurile la care lucrăm pe{" "}
          <a href="https://www.instagram.com/fatacu4pezi/" target="_blank" rel="noopener noreferrer" class="font-semibold text-ink underline decoration-ink/30 hover:decoration-ink">Instagram</a>.
        </p>
      )
    }
  </section>
</PageLayout>
