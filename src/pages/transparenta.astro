---
import PageLayout from "../layouts/PageLayout.astro";
import { site, contact } from "../data/config";
import { withBase } from "../lib/url";

// No real documents exist for any year yet — an empty array here (rather
// than a hardcoded list of years rendered as permanent "În curând" rows)
// means the section below honestly shows nothing until a real year/document
// is added, instead of implying 2023–2025 reports are all in progress.
const publishedDocumentsByYear: { year: number; documents: string[] }[] = [];

const legalFacts = [
  { label: "Denumire legală", value: site.legalName, configured: true },
  { label: "CIF", value: contact.cif, configured: contact.cifConfigured },
  { label: "Număr de înregistrare", value: contact.registrationNumber, configured: contact.registrationNumberConfigured },
  { label: "Cont bancar pentru donații", value: contact.bankAccount, configured: contact.bankAccountConfigured },
].filter((fact) => fact.configured);
---

<PageLayout
  title="Transparență"
  seoTitle="Transparență și informații despre asociație | Fata cu 4pezi"
  description="Consultă informațiile de identificare și documentele publicate de Asociația Fata cu 4pezi, precum și detaliile disponibile despre activitatea organizației."
  intro="Aici reunim informațiile oficiale și documentele disponibile despre activitatea asociației, pentru ca cei care ne susțin să poată consulta date clare și verificabile."
>
  <section class="mx-auto max-w-4xl px-4 pb-20 pt-2 sm:px-6 lg:px-8">
    <div class="rounded-2xl border border-ink/10 bg-paper p-6">
      <h2 class="font-display text-lg font-bold text-ink">Documente și rapoarte</h2>
      {
        publishedDocumentsByYear.length > 0 ? (
          <div class="mt-6 flex flex-col divide-y divide-ink/10">
            {publishedDocumentsByYear.map(({ year, documents }) => (
              <div class="py-4">
                <p class="font-display font-bold text-ink">{year}</p>
                <ul class="mt-3 flex flex-col gap-2.5">
                  {documents.map((doc) => (
                    <li class="text-sm text-ink-soft">{doc}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        ) : (
          <p class="mt-1 text-sm text-ink-soft">Documentele oficiale vor fi publicate aici după verificare și finalizare.</p>
        )
      }
    </div>

    <div class="mt-8 rounded-2xl border border-ink/10 bg-paper p-6">
      <h2 class="font-display text-lg font-bold text-ink">Date de identificare</h2>
      {
        legalFacts.length > 0 ? (
          <dl class="mt-4 grid gap-4 sm:grid-cols-2">
            {legalFacts.map((fact) => (
              <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-ink-soft">{fact.label}</dt>
                <dd class="mt-1 text-sm text-ink">{fact.value}</dd>
              </div>
            ))}
          </dl>
        ) : (
          <p class="mt-1 text-sm text-ink-soft">Datele oficiale de identificare vor fi publicate după confirmare.</p>
        )
      }
    </div>

    <p class="mt-8 text-sm leading-relaxed text-ink-soft">
      Pentru întrebări despre activitatea și documentele asociației, ne poți contacta folosind datele disponibile în pagina{" "}
      <a href={withBase("/contact")} class="font-semibold text-ink underline decoration-ink/30 hover:decoration-ink">Contact</a>.
    </p>
  </section>
</PageLayout>
