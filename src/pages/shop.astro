---
import PageLayout from "../layouts/PageLayout.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
---

<PageLayout
  title="Magazin"
  description="Magazinul Fata cu 4pezi este în pregătire."
  noindex
>
  <section class="mx-auto max-w-2xl px-4 pb-24 pt-2 sm:px-6 lg:px-8">
    <div class="rounded-2xl border-2 border-dashed border-ink/25 bg-paper p-10 text-center">
      <p class="inline-flex items-center gap-2 rounded-full bg-blue px-3 py-1 text-xs font-semibold text-ink">În curând</p>
      <p class="mt-5 text-ink-soft">
        Pregătim un magazin cu produse care susțin direct activitatea de salvare — veniturile vor merge integral
        către tratamente, sterilizări și hrană.
      </p>
      <Button href="/doneaza" variant="primary" size="md" class="mt-6">
        Susține-ne acum printr-o donație
        <Icon name="arrow-right" class="h-4 w-4" />
      </Button>
    </div>
  </section>
</PageLayout>
