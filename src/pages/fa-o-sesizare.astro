---
import PageLayout from "../layouts/PageLayout.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import { contact } from "../data/config";
import { withBase } from "../lib/url";

const checklist = [
  {
    title: "Locația animalului",
    text: "Trimite o adresă, un reper ușor de identificat sau coordonate GPS, dacă le ai.",
  },
  {
    title: "Fotografii, dacă le poți face în siguranță",
    text: "Câteva imagini ne pot ajuta să înțelegem situația. Nu te apropia de un animal speriat sau rănit doar pentru a obține fotografii.",
  },
  {
    title: "Ce ai observat",
    text: "Spune-ne dacă animalul pare rănit, blocat, slăbit sau expus unui pericol și de cât timp se află în acel loc, dacă știi.",
  },
  {
    title: "Cum te putem contacta",
    text: "Lasă o adresă de e-mail sau un număr de telefon la care putem reveni dacă sunt necesare informații suplimentare.",
  },
];

const subject = encodeURIComponent("Sesizare — animal în dificultate");
const body = encodeURIComponent(
  `Locație (adresă / reper / coordonate GPS):\n\nCe ai observat:\n\nDe cât timp este acolo:\n\nFotografii atașate: da / nu\n\nDatele tale de contact:\n`
);
const mailtoHref = `mailto:${contact.reportEmail}?subject=${subject}&body=${body}`;
---

<PageLayout
  title="Ai găsit un animal în pericol?"
  seoTitle="Ai găsit un animal în pericol? Semnalează cazul | Fata cu 4pezi"
  description="Ai găsit un animal rănit, abandonat sau aflat în pericol în București ori Ilfov? Află ce informații sunt utile pentru o sesizare către Fata cu 4pezi."
  intro="Dacă ai observat un animal rănit, abandonat sau aflat în dificultate în București ori Ilfov, ne poți semnala situația. Informațiile cât mai clare ne ajută să evaluăm cazul."
>
  <section class="mx-auto max-w-5xl px-4 pb-20 pt-2 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[1fr_320px]">
      <div>
        <h2 class="font-display text-xl font-bold text-ink">Ce informații ne sunt utile</h2>
        <ul class="mt-6 flex flex-col gap-6">
          {
            checklist.map((item, i) => (
              <li class="flex gap-4">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border-2 border-ink/25 font-display text-sm font-bold text-ink">
                  {i + 1}
                </span>
                <div>
                  <p class="font-semibold text-ink">{item.title}</p>
                  <p class="mt-1 text-sm leading-relaxed text-ink-soft">{item.text}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <p class="mt-10 max-w-xl text-sm leading-relaxed text-ink-soft">
          Nu trebuie să ai toate informațiile pentru a trimite o sesizare. Comunică ceea ce știi și evită să te pui în pericol.
        </p>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-ink-soft">
          Dacă animalul are nevoie de ajutor medical urgent, contactează un medic veterinar sau serviciile competente. Trimiterea unui
          e-mail către asociație nu garantează o intervenție imediată.
        </p>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-ink-soft">
          <a href={withBase("/blog/ce-faci-daca-gasesti-un-animal-ranit-pe-strada")} class="font-semibold text-ink underline decoration-ink/30 hover:decoration-ink">
            Citește ghidul pentru animale găsite în dificultate.
          </a>
        </p>
      </div>

      <aside class="h-fit rounded-2xl border border-ink/10 bg-paper p-6">
        <h2 class="font-display text-lg font-bold text-ink">Trimite o sesizare</h2>
        {
          contact.reportEmailConfigured ? (
            <>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                Butonul deschide aplicația ta de e-mail și pregătește un mesaj pe care îl poți completa înainte de trimitere.
              </p>
              <Button href={mailtoHref} variant="primary" size="md" class="mt-5 w-full">
                <Icon name="mail" class="h-4 w-4" />
                Pregătește sesizarea prin e-mail
              </Button>
              <p class="mt-3 text-xs text-ink-soft">{contact.reportEmail}</p>
            </>
          ) : (
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">
              Adresa dedicată sesizărilor va fi disponibilă în curând.
            </p>
          )
        }
      </aside>
    </div>
  </section>
</PageLayout>
