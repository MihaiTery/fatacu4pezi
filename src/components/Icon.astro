---
// Small hand-authored line-icon system: 24x24, 1.75 stroke, round caps/joins.
// Kept as one component (not a dependency) so every icon shares exactly one
// stroke weight and the bundle stays tiny.
interface Props {
  name:
    | "menu"
    | "close"
    | "chevron-down"
    | "chevron-right"
    | "arrow-right"
    | "external"
    | "mail"
    | "phone"
    | "map-pin"
    | "check"
    | "circle-dot"
    | "filter"
    | "dog"
    | "cat";
  class?: string;
}

const { name, class: className } = Astro.props;
---

{
  name === "menu" && (
    <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
      <line x1="3.5" y1="7" x2="20.5" y2="7" />
      <line x1="3.5" y1="12" x2="20.5" y2="12" />
      <line x1="3.5" y1="17" x2="20.5" y2="17" />
    </svg>
  )
}
{
  name === "close" && (
    <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
      <line x1="5" y1="5" x2="19" y2="19" />
      <line x1="19" y1="5" x2="5" y2="19" />
    </svg>
  )
}
{
  name === "chevron-down" && (
    <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="6 9 12 15 18 9" />
    </svg>
  )
}
{
  name === "chevron-right" && (
    <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="9 6 15 12 9 18" />
    </svg>
  )
}
{
  name === "arrow-right" && (
    <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="4" y1="12" x2="19" y2="12" />
      <polyline points="13 6 19 12 13 18" />
    </svg>
  )
}
{
  name === "external" && (
    <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-3" />
      <polyline points="14 4 20 4 20 10" />
      <line x1="20" y1="4" x2="11" y2="13" />
    </svg>
  )
}
{
  name === "mail" && (
    <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2.5" />
      <polyline points="3.5 6.5 12 13 20.5 6.5" />
    </svg>
  )
}
{
  name === "phone" && (
    <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6.5 4h2.7l1.3 4.2-2 1.6a11.6 11.6 0 0 0 5.7 5.7l1.6-2 4.2 1.3v2.7c0 1.1-.9 2-2 2C10.6 19.5 4.5 13.4 4.5 6c0-1.1.9-2 2-2Z" />
    </svg>
  )
}
{
  name === "map-pin" && (
    <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 21.5S5 14.9 5 9.8a7 7 0 1 1 14 0c0 5.1-7 11.7-7 11.7Z" />
      <circle cx="12" cy="9.8" r="2.4" />
    </svg>
  )
}
{
  name === "check" && (
    <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="4.5 12.5 9.5 17.5 19.5 6.5" />
    </svg>
  )
}
{
  name === "circle-dot" && (
    <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
      <circle cx="12" cy="12" r="8.5" />
      <circle cx="12" cy="12" r="2.4" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  name === "filter" && (
    <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="4" y1="7" x2="20" y2="7" />
      <line x1="4" y1="12" x2="20" y2="12" />
      <line x1="4" y1="17" x2="20" y2="17" />
      <circle cx="9" cy="7" r="2" fill="var(--color-cream)" />
      <circle cx="16" cy="12" r="2" fill="var(--color-cream)" />
      <circle cx="10" cy="17" r="2" fill="var(--color-cream)" />
    </svg>
  )
}
{
  name === "dog" && (
    <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <ellipse cx="6.3" cy="12.2" rx="2.4" ry="4" transform="rotate(-20 6.3 12.2)" />
      <ellipse cx="17.7" cy="12.2" rx="2.4" ry="4" transform="rotate(20 17.7 12.2)" />
      <circle cx="12" cy="12.5" r="6.2" />
    </svg>
  )
}
{
  name === "cat" && (
    <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6.2 9.4 9 3l1 5.2" />
      <path d="M17.8 9.4 15 3l-1 5.2" />
      <circle cx="12" cy="13" r="6.2" />
    </svg>
  )
}
