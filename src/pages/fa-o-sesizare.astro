---
import PageLayout from "../layouts/PageLayout.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import { policeReportUrl } from "../data/config";

const checklist = [
  {
    title: "Locația animalului",
    text: "Notează o adresă, un reper ușor de identificat sau coordonate GPS, dacă le ai.",
  },
  {
    title: "Fotografii, dacă le poți face în siguranță",
    text: "Câteva imagini pot ajuta la înțelegerea situației. Nu te apropia de un animal speriat sau rănit doar pentru a obține fotografii. Pe cât posibil, evită să fotografiezi alte persoane sau detalii care le pot identifica, dacă nu sunt necesare pentru sesizare.",
  },
  {
    title: "Ce ai observat",
    text: "Descrie dacă animalul pare rănit, blocat, slăbit sau expus unui pericol și de cât timp se află în acel loc, dacă știi.",
  },
  {
    title: "Datele tale de contact",
    text: "Petițiile anonime nu sunt luate în considerare, așa că formularul îți va cere datele de identificare și de contact. Pe acestea vei primi răspunsul.",
  },
];
---

<PageLayout
  title="Ai găsit un animal în pericol?"
  seoTitle="Ai găsit un animal în pericol? Semnalează cazul | Fata cu 4pezi"
  description="Ai găsit un animal rănit, abandonat sau aflat în pericol oriunde în România? Află ce informații sunt utile și cum faci o sesizare la Poliția Română."
  intro="Dacă ai observat un animal rănit, abandonat sau aflat în dificultate, oriunde în România, poți face o sesizare online la Poliția Română. Informațiile cât mai clare ajută la evaluarea cazului."
>
  <section class="mx-auto max-w-5xl px-4 pb-20 pt-2 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[1fr_320px]">
      <div>
        <h2 class="font-display text-xl font-bold text-ink">Ce informații sunt utile</h2>
        <ul class="mt-6 flex flex-col gap-6">
          {
            checklist.map((item, i) => (
              <li class="flex gap-4">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border-2 border-ink/25 font-display text-sm font-bold text-ink">
                  {i + 1}
                </span>
                <div>
                  <p class="font-semibold text-ink">{item.title}</p>
                  <p class="mt-1 text-sm leading-relaxed text-ink-soft">{item.text}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <p class="mt-10 max-w-xl text-sm leading-relaxed text-ink-soft">
          Nu trebuie să ai toate informațiile pentru a face o sesizare. Comunică ceea ce știi și evită să te pui în pericol.
        </p>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-ink-soft">
          Dacă un animal este agresat chiar acum, sună la 112. Dacă are nevoie de ajutor medical urgent, contactează un medic
          veterinar. Un formular online nu garantează o intervenție imediată.
        </p>
      </div>

      <aside class="h-fit rounded-2xl border border-ink/10 bg-paper p-6">
        <h2 class="font-display text-lg font-bold text-ink">Fă o sesizare</h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">
          Butonul deschide, într-un tab nou, formularul de petiție online al Poliției Române.
        </p>
        <Button href={policeReportUrl} external variant="primary" size="md" class="mt-5 w-full">
          Deschide formularul Poliției
          <Icon name="external" class="h-4 w-4" />
        </Button>
        <p class="mt-4 border-t border-ink/10 pt-4 text-xs leading-relaxed text-ink-soft">
          Sesizarea ajunge direct la Poliția Română, nu la asociație. Datele pe care le completezi în formular sunt prelucrate de
          Poliția Română, conform regulilor de pe site-ul acesteia.
        </p>
      </aside>
    </div>
  </section>
</PageLayout>
