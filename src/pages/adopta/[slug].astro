---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Button from "../../components/Button.astro";
import StatusPill from "../../components/StatusPill.astro";
import Icon from "../../components/Icon.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import { contact } from "../../data/config";
import { withBase } from "../../lib/url";

export async function getStaticPaths() {
  const animals = await getCollection("animals");
  return animals.map((animal) => ({
    params: { slug: animal.id },
    props: { animal },
  }));
}

const { animal } = Astro.props;
const a = animal.data;
const { Content } = await render(animal);

const sexLabel = a.sex === "mascul" ? "Mascul" : "Femelă";
const speciesLabel = a.species === "caine" ? "Câine" : "Pisică";

const medicalFacts = [
  { label: "Sterilizat", value: a.sterilized },
  { label: "Vaccinat", value: a.vaccinated },
  { label: "Deparazitat", value: a.dewormed },
];

const canAdopt = a.status === "disponibil";
const mailSubject = encodeURIComponent(`Adopție — ${a.name}`);
const mailBody = encodeURIComponent(
  `Bună,\n\nAș dori să aflu mai multe despre procesul de adopție pentru ${a.name} (${speciesLabel.toLowerCase()}).\n\nNume:\nZonă/localitate:\nExperiență anterioară cu animale:\n\nMulțumesc!`
);
const mailtoHref = `mailto:${contact.email}?subject=${mailSubject}&body=${mailBody}`;
---

<Layout
  title={`${a.name} — ${speciesLabel.toLowerCase()} pentru adopție`}
  description={`${a.name}, ${speciesLabel.toLowerCase()} ${sexLabel.toLowerCase()}, ${a.ageLabel}. ${a.photoAlt}`}
>
  <div class="flex min-h-screen flex-col">
    <SiteHeader />
    <main id="main" class="flex-1">
  <div class="mx-auto max-w-5xl px-4 pb-20 pt-10 sm:px-6 sm:pt-14 lg:px-8">
    <a href={withBase("/adopta")} class="mb-6 inline-flex items-center gap-1.5 text-sm font-medium text-ink-soft hover:text-ink">
      <Icon name="chevron-right" class="h-4 w-4 rotate-180" />
      Înapoi la toate animalele
    </a>

    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_320px]">
      <div>
        <div class="relative overflow-hidden rounded-2xl">
          <Image src={a.photo} alt={a.photoAlt} width={800} height={600} class="aspect-[4/3] w-full object-cover" />
          <StatusPill status={a.status} class="absolute left-4 top-4 shadow-sm" />
        </div>

        <div class="mt-8 flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <h1 class="font-display text-4xl font-bold text-ink">{a.name}</h1>
          <p class="text-lg text-ink-soft">{speciesLabel} · {sexLabel} · {a.ageLabel}</p>
        </div>
        <p class="mt-1 text-sm text-ink-soft">{a.arrivedLabel}</p>

        <div class="prose-fatacu mt-6 max-w-prose text-ink-soft">
          <Content />
        </div>
      </div>

      <aside class="flex flex-col gap-6">
        <div class="rounded-2xl border border-ink/10 bg-paper p-6">
          <h2 class="font-display text-sm font-bold uppercase tracking-wide text-ink-soft">Stare medicală</h2>
          <ul class="mt-4 flex flex-col gap-2.5">
            {
              medicalFacts.map((fact) => (
                <li class="flex items-center gap-2.5 text-sm">
                  <span
                    class={`flex h-5 w-5 shrink-0 items-center justify-center rounded-full ${
                      fact.value ? "bg-green text-cream" : "border border-ink/25 text-ink/40"
                    }`}
                  >
                    {fact.value && <Icon name="check" class="h-3 w-3" />}
                  </span>
                  <span class={fact.value ? "text-ink" : "text-ink-soft"}>{fact.label}{!fact.value && " — în curs"}</span>
                </li>
              ))
            }
          </ul>

          {
            a.goodWith.length > 0 && (
              <>
                <h2 class="mt-6 font-display text-sm font-bold uppercase tracking-wide text-ink-soft">Se înțelege bine cu</h2>
                <ul class="mt-3 flex flex-wrap gap-1.5">
                  {a.goodWith.map((tag) => (
                    <li class="rounded-full bg-ink/5 px-2.5 py-1 text-xs text-ink-soft">{tag}</li>
                  ))}
                </ul>
              </>
            )
          }

          <h2 class="mt-6 font-display text-sm font-bold uppercase tracking-wide text-ink-soft">Temperament</h2>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {a.personality.map((trait) => <li class="rounded-full bg-ink/5 px-2.5 py-1 text-xs text-ink-soft">{trait}</li>)}
          </ul>
        </div>

        {
          canAdopt ? (
            <Button href={mailtoHref} variant="primary" size="lg" class="w-full">
              Vreau să adopt pe {a.name}
            </Button>
          ) : (
            <div class="rounded-2xl border border-ink/10 bg-paper p-5 text-sm text-ink-soft">
              {a.status === "adoptat"
                ? `${a.name} a fost deja adoptat${a.sex === "femela" ? "ă" : ""} — profilul rămâne vizibil pentru transparență.`
                : a.status === "rezervat"
                  ? `${a.name} este rezervat${a.sex === "femela" ? "ă" : ""} — procesul de adopție este deja în desfășurare cu o altă familie.`
                  : `${a.name} este momentan în tratament veterinar. Va deveni disponibil${a.sex === "femela" ? "ă" : ""} imediat ce este pregătit${a.sex === "femela" ? "ă" : ""}.`}
              <Button href="/adopta" variant="ghost" class="mt-3">
                Vezi alte animale disponibile
              </Button>
            </div>
          )
        }
      </aside>
    </div>
  </div>
    </main>
    <SiteFooter />
  </div>
</Layout>
