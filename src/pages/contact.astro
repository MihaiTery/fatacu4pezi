---
import PageLayout from "../layouts/PageLayout.astro";
import Icon from "../components/Icon.astro";
import SocialBadge from "../components/SocialBadge.astro";
import Button from "../components/Button.astro";
import { site, legal, contact, social, legalLinks } from "../data/config";
import { withBase } from "../lib/url";

const quickLinks = [
  { title: "Ai găsit un animal în pericol?", href: "/fa-o-sesizare", cta: "Trimite o sesizare" },
  { title: "Vrei să adopți un animal?", href: "/adopta", cta: "Vezi animalele pentru adopție" },
  { title: "Vrei să devii partener?", href: "/parteneri", cta: "Descoperă cum putem colabora" },
];

const hasSocial = social.some((s) => s.url);
---

<PageLayout
  title="Contact"
  seoTitle="Contact Fata cu 4pezi | România"
  description="Contactează Asociația Fata cu 4pezi pentru informații despre adopții, sesizări, voluntariat, parteneriate și sprijinirea animalelor de pe străzi din toată România."
  intro="Ai o întrebare despre asociație sau vrei să ne scrii? Alege mai jos subiectul potrivit, iar pentru întrebări generale folosește datele de contact disponibile."
>
  <section class="mx-auto max-w-5xl px-4 pb-20 pt-2 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[1fr_1fr]">
      <div class="rounded-2xl border border-ink/10 bg-paper p-7">
        <h2 class="font-display text-lg font-bold text-ink">{site.legalName}</h2>
        <p class="mt-1 text-sm text-ink-soft">CUI {legal.cif}</p>
        {legal.registrationNumber && (
          <p class="text-sm text-ink-soft">Nr. Registrul Asociațiilor și Fundațiilor {legal.registrationNumber}</p>
        )}
        <ul class="mt-5 flex flex-col gap-4 text-sm">
          {contact.email && (
            <li class="flex items-start gap-3">
              <Icon name="mail" class="mt-0.5 h-4 w-4 shrink-0 text-ink-soft" />
              <a href={`mailto:${contact.email}`} class="min-w-0 text-ink [overflow-wrap:anywhere] hover:text-green">{contact.email}</a>
            </li>
          )}
          {contact.phone && (
            <li class="flex items-start gap-3">
              <Icon name="phone" class="mt-0.5 h-4 w-4 shrink-0 text-ink-soft" />
              <span>
                <a href={`tel:${contact.phone.replace(/\s+/g, "")}`} class="text-ink hover:text-green">{contact.phone}</a>
                {contact.phoneContactName && <span class="block text-xs text-ink-soft">{contact.phoneContactName}</span>}
              </span>
            </li>
          )}
          <li class="flex items-start gap-3">
            <Icon name="map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-ink-soft" />
            <span class="text-ink">
              <span class="block text-xs font-semibold uppercase tracking-wide text-ink-soft">Sediu social</span>
              {legal.address}
            </span>
          </li>
        </ul>
        <p class="mt-5 text-sm leading-relaxed text-ink-soft">
          {!contact.email && !contact.phone && "Adresa de e-mail și numărul de telefon vor fi publicate aici după confirmare. "}
          Adresa de mai sus este sediul social al asociației, nu un punct de primire a animalelor.
        </p>
        <p class="mt-5 text-xs leading-relaxed text-ink-soft">
          Datele pe care alegi să ni le trimiți sunt folosite pentru a-ți răspunde. Detalii în{" "}
          <a href={withBase(legalLinks.privacyPolicy)} class="font-semibold text-ink underline decoration-ink/30 hover:decoration-ink">Politica de confidențialitate</a>.
        </p>
        {hasSocial && <SocialBadge size="md" class="mt-6" />}
      </div>

      <div class="flex flex-col gap-4">
        {
          quickLinks.map((link) => (
            <div class="flex flex-col gap-2 rounded-2xl border border-ink/10 bg-paper p-6">
              <p class="font-semibold text-ink">{link.title}</p>
              <Button href={link.href} variant="ghost" class="self-start">
                {link.cta}
                <Icon name="arrow-right" class="h-4 w-4" />
              </Button>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</PageLayout>
