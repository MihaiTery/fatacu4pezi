---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Icon from "./Icon.astro";

interface Props {
  partner: CollectionEntry<"partners">;
}

const { partner } = Astro.props;
const p = partner.data;

const typeLabels: Record<typeof p.type, string> = {
  clinica_veterinara: "Clinică veterinară",
  farmacie_veterinara: "Farmacie veterinară",
  companie: "Companie parteneră",
  organizatie: "Organizație parteneră",
  altul: "Partener",
};
---

<article class="card-lift flex flex-col gap-4 rounded-2xl border border-ink/10 bg-paper p-6 transition-colors hover:border-ink/25 sm:flex-row sm:items-start">
  <Image src={p.logo} alt="" width={72} height={72} class="h-16 w-16 shrink-0 rounded-xl" />
  <div class="flex-1">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h3 class="font-display text-lg font-bold text-ink">{p.name}</h3>
      <span class="text-xs font-semibold uppercase tracking-wide text-green">{typeLabels[p.type]}</span>
    </div>
    <p class="mt-2 text-sm leading-relaxed text-ink-soft">{p.contribution}</p>
    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-sm text-ink-soft">
      {
        p.location && (
          <span class="inline-flex items-center gap-1.5">
            <Icon name="map-pin" class="h-4 w-4" />
            {p.location}
          </span>
        )
      }
      {p.since && <span>{p.since}</span>}
      {
        p.url && (
          <a href={p.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 font-medium text-ink hover:text-green">
            Vizitează
            <Icon name="external" class="h-3.5 w-3.5" />
          </a>
        )
      }
    </div>
  </div>
</article>
