---
import Logo from "./Logo.astro";
import SocialBadge from "./SocialBadge.astro";
import Icon from "./Icon.astro";
import EmailText from "./EmailText.astro";
import { site, legal, contact, nav, legalLinks, credits } from "../data/config";
import { withBase } from "../lib/url";

const year = new Date().getFullYear();

const legalNav = [
  { label: "Politica de confidențialitate", href: legalLinks.privacyPolicy },
  { label: "Politica de cookies", href: legalLinks.cookiePolicy },
  { label: "Termeni de utilizare", href: legalLinks.terms },
  { label: "Informații legale", href: legalLinks.legalInfo },
];

const unsubscribeHref = contact.email
  ? `mailto:${contact.email}?subject=${encodeURIComponent("Dezabonare newsletter")}&body=${encodeURIComponent(
      "Vă rog să dezabonați această adresă de la newsletter-ul Asociației Fata cu 4pezi."
    )}`
  : null;
---

<footer class="bg-animals bg-pink text-ink [--animals-ink:var(--color-cream)] [--animals-size:340px]">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <!-- Mobile packs the footer tight: logo beside the description, the
         link lists in two columns (Navigare spans two rows on the left,
         Implică-te with Contact under it on the right). From
         sm the three link groups share a row; from lg the original four
         columns return. -->
    <div class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-3 sm:gap-y-10 lg:grid-cols-[1.2fr_1fr_1fr_1fr] lg:gap-12">
      <div class="col-span-2 grid grid-cols-[7rem_1fr] items-center gap-x-4 gap-y-4 sm:col-span-3 sm:grid-cols-[9rem_1fr] lg:col-span-1 lg:flex lg:flex-col lg:items-stretch">
        <!-- Same cream roundel as the header badge, scaled up, so the logo
             sits on a clean ground instead of over the animal pattern. -->
        <span class="flex aspect-square h-28 shrink-0 items-center justify-center self-start rounded-full border border-ink/10 bg-cream p-3 sm:h-36 sm:p-4 lg:h-52 lg:p-5">
          <Logo variant="maro" class="h-full w-full -translate-y-[10%] object-contain" />
        </span>
        <p class="max-w-xs text-[0.8125rem] leading-relaxed text-ink/80 sm:text-sm">
          {site.shortDescription}
        </p>
        <SocialBadge tone="ink" size="md" class="col-span-2 lg:mt-1" />
      </div>

      <div class="row-span-2 sm:row-span-1">
        <p class="font-display text-sm font-bold uppercase tracking-wide text-ink/70">Navigare</p>
        <ul class="mt-3 flex flex-col gap-2 text-sm lg:mt-4 lg:gap-2.5">
          {
            nav.map((item) => (
              <li>
                <a href={withBase(item.href)} class="text-ink/70 hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="font-display text-sm font-bold uppercase tracking-wide text-ink/70">Implică-te</p>
        <ul class="mt-3 flex flex-col gap-2 text-sm lg:mt-4 lg:gap-2.5">
          <li><a href={withBase("/doneaza")} class="text-ink/70 hover:text-ink">Donează</a></li>
          <li><a href={withBase("/redirectioneaza")} class="text-ink/70 hover:text-ink">Redirecționează 3,5%</a></li>
          <li><a href={withBase("/adopta")} class="text-ink/70 hover:text-ink">Adoptă un animal</a></li>
          <li><a href={withBase("/voluntari")} class="text-ink/70 hover:text-ink">Devino voluntar</a></li>
          <li><a href={withBase("/parteneri")} class="text-ink/70 hover:text-ink">Devino partener</a></li>
        </ul>
      </div>

      <div class="min-w-0">
        <p class="font-display text-sm font-bold uppercase tracking-wide text-ink/70">Contact</p>
        <ul class="mt-3 flex flex-col gap-2.5 text-sm text-ink/80 lg:mt-4 lg:gap-3">
          {
            contact.email && (
              <li class="flex items-start gap-2.5">
                <Icon name="mail" class="mt-0.5 h-4 w-4 shrink-0 text-ink/60" />
                <a href={`mailto:${contact.email}`} class="min-w-0 [overflow-wrap:anywhere] hover:text-ink"><EmailText email={contact.email} /></a>
              </li>
            )
          }
          {
            contact.phone && (
              <li class="flex items-start gap-2.5">
                <Icon name="phone" class="mt-0.5 h-4 w-4 shrink-0 text-ink/60" />
                <span>
                  <a href={`tel:${contact.phone.replace(/\s+/g, "")}`} class="hover:text-ink">{contact.phone}</a>
                  {contact.phoneContactName && <span class="block text-xs text-ink/70">{contact.phoneContactName}</span>}
                </span>
              </li>
            )
          }
          <li class="flex items-start gap-2.5">
            <Icon name="map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-ink/60" />
            <span>{site.area}</span>
          </li>
        </ul>
      </div>
    </div>

    <div id="newsletter" class="mt-8 scroll-mt-24 rounded-2xl border border-ink/15 bg-cream/70 p-5 sm:mt-12 sm:p-7">
      <div class="flex flex-wrap items-start justify-between gap-4 sm:gap-6">
        <div class="max-w-sm">
          <p class="font-display text-xs font-bold uppercase tracking-wide text-ink/70">Newsletter</p>
          <h2 class="mt-1.5 font-display text-lg font-bold text-ink">Vești despre animalele ajutate, direct pe e-mail</h2>
          <p class="mt-2 text-sm leading-relaxed text-ink/70">
            Trimitem ocazional noutăți despre cazurile sprijinite, campanii de sterilizare și cum poți ajuta.
          </p>
        </div>

        {
          contact.email ? (
            <form class="flex w-full max-w-sm flex-col gap-3" data-newsletter-form data-mailto={contact.email} novalidate>
              <div class="flex flex-col gap-2 sm:flex-row">
                <label for="nl-email" class="sr-only">Adresă de e-mail</label>
                <input
                  id="nl-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                  placeholder="adresa@exemplu.ro"
                  class="w-full flex-1 rounded-full border border-ink/20 bg-cream px-4 py-2.5 text-sm text-ink placeholder:text-ink/40"
                />
                <button
                  type="submit"
                  class="inline-flex shrink-0 items-center justify-center gap-1.5 rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-cream transition-colors duration-150 hover:bg-[#2a1108] focus-visible:outline-2 focus-visible:outline-offset-3"
                >
                  Abonează-te
                </button>
              </div>
              <!-- The newsletter is the one flow that genuinely rests on
                   consent (GDPR art. 6(1)(a)): a separate, never-prechecked
                   box the visitor has to tick themselves. -->
              <label class="flex items-start gap-2 text-xs leading-relaxed text-ink/70">
                <input id="nl-consent" name="consent" type="checkbox" required class="mt-0.5 h-4 w-4 shrink-0 rounded border border-ink/30" />
                <span>Vreau să primesc pe e-mail newsletter-ul Asociației Fata cu 4pezi: vești despre animalele ajutate, campanii și modalități de implicare.</span>
              </label>
              <p class="text-xs leading-relaxed text-ink/70">
                Se va deschide aplicația ta de e-mail cu o cerere de abonare; adresa ajunge la noi doar dacă trimiți mesajul.
                Te poți dezabona oricând{unsubscribeHref && (
                  <>
                    {" "}(<a href={unsubscribeHref} class="underline hover:text-ink">trimite o cerere de dezabonare</a>)
                  </>
                )}. Detalii în{" "}
                <a href={withBase(legalLinks.privacyPolicy)} class="underline hover:text-ink">Politica de confidențialitate</a>.
              </p>
              <p class="hidden text-xs font-medium text-green" data-newsletter-confirm role="status">
                Dacă s-a deschis aplicația de e-mail, apasă „Trimite” pentru a confirma abonarea. Mulțumim! Între timp,
                <a href={withBase("/doneaza#wallpapere")} class="underline underline-offset-2 hover:text-green-dark">descarcă un wallpaper</a>.
              </p>
            </form>
          ) : (
            <p class="w-full max-w-sm text-sm leading-relaxed text-ink/70">
              Abonarea va fi disponibilă după activarea adresei de e-mail a asociației. Până atunci,{" "}
              <a href={withBase("/doneaza#wallpapere")} class="underline underline-offset-2 hover:text-ink">descarcă un wallpaper</a>.
            </p>
          )
        }
      </div>
    </div>

    <div class="mt-8 sm:mt-10 flex flex-col gap-4 border-t border-ink/15 pt-6 text-xs text-ink/75 lg:flex-row lg:items-start lg:justify-between">
      <div class="flex flex-col gap-1">
        <p>© {year} {site.legalName}. Toate drepturile rezervate.</p>
        <p>
          CUI {legal.cif}
          {legal.registrationNumber && <> · Nr. Registrul Asociațiilor și Fundațiilor {legal.registrationNumber}</>}
        </p>
      </div>
      <nav aria-label="Informații juridice">
        <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
          {
            legalNav.map((item) => (
              <li>
                <a href={withBase(item.href)} class="underline decoration-ink/25 underline-offset-2 hover:text-ink hover:decoration-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={credits.studioUrl} target="_blank" rel="noopener noreferrer" class="hover:text-ink">
              Design de {credits.studioName}
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>

<script>
  // TODO(newsletter-provider): once an ESP (Mailchimp, Brevo, etc.) is
  // chosen, point this form at its signup endpoint instead — and update the
  // privacy/cookie policies first. Until then it falls back to a mailto
  // request, same pattern as the volunteer form. The form only renders once
  // contact.email is confirmed.
  import { fireConfetti } from "../lib/confetti";

  const form = document.querySelector<HTMLFormElement>("[data-newsletter-form]");
  const confirmNote = document.querySelector<HTMLElement>("[data-newsletter-confirm]");
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const email = new FormData(form).get("email");
    const mailto = form.dataset.mailto;
    const subject = encodeURIComponent("Abonare newsletter");
    const body = encodeURIComponent(
      `Solicit abonarea acestei adrese la newsletter-ul Asociației Fata cu 4pezi.

Adresa de e-mail: ${email}`
    );
    // Burst first, while the button is still measurable on screen, then hand
    // off to the mail app — on mobile, opening the mailto link right away can
    // pull the page out from under the animation before it is placed.
    confirmNote?.classList.remove("hidden");
    if (submitButton) fireConfetti(submitButton);
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    window.setTimeout(
      () => {
        window.location.href = `mailto:${mailto}?subject=${subject}&body=${body}`;
      },
      reduceMotion ? 0 : 450
    );
  });
</script>
