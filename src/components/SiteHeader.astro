---
import Logo from "./Logo.astro";
import Button from "./Button.astro";
import SocialBadge from "./SocialBadge.astro";
import { nav, social } from "../data/config";
import { withBase } from "../lib/url";

// The social row exists only to hold the social badges — skip it entirely
// while no official profile URL is confirmed.
const hasSocial = social.some((s) => s.url);
const currentPath = Astro.url.pathname;
// Astro.url.pathname includes the deploy base, if one is configured, so
// the comparison target needs the same prefix — comparing against the bare
// config href would never match once a base path is configured.
const isActive = (href: string) => {
  const target = withBase(href);
  return href === "/" ? currentPath === target : currentPath.startsWith(target);
};
---

<header class="sticky top-0 z-40">
  <!-- Transparent: no fill of its own, so it reads as a light utility row
       floating above the solid nav bar rather than one undifferentiated
       pink block. Whatever the page shows behind it (almost always cream)
       shows through. -->
  {
    hasSocial && (
      <div class="border-b border-ink/10">
        <div class="mx-auto flex max-w-7xl items-center justify-end px-4 py-1.5 sm:px-6 lg:px-8">
          <SocialBadge tone="ink" />
        </div>
      </div>
    )
  }

  <div class="bg-pink text-ink">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2.5 sm:px-6 lg:px-8">
      <!-- The wide wordmark spells out the association's full name beside the
           crest — only below lg, where the nav folds into the menu pill. At
           lg+ the nav and CTAs need the room (they wrap even at 1568px), so
           the full name is carried by the footer there. -->
      <a href={withBase("/")} class="flex min-w-0 items-center gap-3 sm:gap-4" aria-label="Asociația Fata cu 4pezi — acasă">
        <span class="flex aspect-square h-[7.28rem] shrink-0 items-center justify-center overflow-visible rounded-full border border-ink/10 bg-cream p-[1.1rem] sm:h-[8.32rem] sm:p-[1.3rem]">
          <Logo variant="maro" class="h-full w-full object-contain" priority />
        </span>
        <Logo kind="wordmark" variant="maro" class="hidden h-auto w-36 min-w-0 sm:block sm:w-48 lg:hidden" priority />
      </a>

      <nav class="hidden items-center gap-6 lg:flex" aria-label="Navigație principală">
        {
          nav.slice(0, 6).map((item) => (
            <a
              href={withBase(item.href)}
              class={`text-[0.95rem] font-medium transition-colors hover:text-ink ${
                isActive(item.href) ? "text-ink underline decoration-2 underline-offset-8" : "text-ink/70"
              }`}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="hidden items-center gap-2.5 lg:flex">
        <Button href="#newsletter" variant="outline" size="sm">Newsletter</Button>
        <Button href="/redirectioneaza" variant="accent" size="sm">
          Redirecționează 3,5%
        </Button>
        <Button href="/doneaza" variant="primary" size="sm">Donează</Button>
      </div>

      <!-- Mobile menu toggle: a labelled cream pill (same register as the
           other header buttons) instead of a bare icon. The three lines are
           deliberately uneven, like the hand-drawn line art elsewhere, and
           fold into an X while the panel is open; the pill inverts to ink
           so the open state reads at a glance. State is driven purely by
           aria-expanded, which the script below already toggles. -->
      <button
        type="button"
        class="group inline-flex min-h-11 min-w-28 items-center justify-between gap-2.5 rounded-full border border-ink/20 bg-cream py-2 pl-4 pr-3.5 text-sm font-semibold text-ink transition-colors duration-200 hover:border-ink focus-visible:outline-2 focus-visible:outline-offset-3 aria-expanded:border-ink aria-expanded:bg-ink aria-expanded:text-cream lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="group-aria-expanded:hidden">Meniu</span>
        <span class="hidden group-aria-expanded:inline">Închide</span>
        <span class="relative block h-3.5 w-[18px]" aria-hidden="true">
          <span class="absolute right-0 top-0 h-[2px] w-[18px] rounded-full bg-current transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-aria-expanded:translate-y-[6px] group-aria-expanded:rotate-45 motion-reduce:transition-none"></span>
          <span class="absolute right-0 top-[6px] h-[2px] w-3 rounded-full bg-current transition-[opacity,transform] duration-200 group-aria-expanded:scale-x-0 group-aria-expanded:opacity-0 motion-reduce:transition-none"></span>
          <span class="absolute right-0 top-[12px] h-[2px] w-[14px] rounded-full bg-current transition-[transform,width] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-aria-expanded:w-[18px] group-aria-expanded:-translate-y-[6px] group-aria-expanded:-rotate-45 motion-reduce:transition-none"></span>
        </span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-ink/10 bg-pink lg:hidden" data-menu-panel>
    <nav class="mx-auto flex max-w-7xl flex-col gap-1 px-4 py-4 sm:px-6" aria-label="Navigație mobilă">
      {
        nav.map((item) => (
          <a
            href={withBase(item.href)}
            class={`rounded-lg px-3 py-2.5 text-[0.95rem] font-medium ${
              isActive(item.href) ? "bg-ink/10 text-ink" : "text-ink/80 hover:bg-ink/5"
            }`}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <div class="mt-3 flex flex-col gap-2.5 border-t border-ink/10 pt-4">
        <Button href="/doneaza" variant="primary" size="md">Donează</Button>
        <Button href="/redirectioneaza" variant="accent" size="md">
          Redirecționează 3,5%
        </Button>
        <Button href="#newsletter" variant="outline" size="md">Newsletter</Button>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    panel?.classList.toggle("hidden", isOpen);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      toggle.setAttribute("aria-expanded", "false");
      panel?.classList.add("hidden");
      toggle.focus();
    }
  });

  // A link to another page reloads and closes the panel implicitly. An
  // in-page anchor (the newsletter box) doesn't, so every panel link gets
  // an explicit close on click.
  panel?.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
    link.addEventListener("click", () => {
      toggle?.setAttribute("aria-expanded", "false");
      panel.classList.add("hidden");
    });
  });
</script>
