---
import PageLayout from "../layouts/PageLayout.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import { donations, contact, redirect230 } from "../data/config";
---

<PageLayout
  title="Donează"
  description="Susține Asociația Fata cu 4pezi printr-o donație — plata online cu cardul este în pregătire; între timp, poți dona prin transfer bancar."
  intro="O donație acoperă direct tratamente veterinare, sterilizări și hrană pentru animalele aflate în grija noastră."
>
  <section class="mx-auto max-w-3xl px-4 pb-20 pt-2 sm:px-6 lg:px-8">
    <div class="rounded-2xl border-2 border-dashed border-ink/25 bg-paper p-7">
      <p class="inline-flex items-center gap-2 rounded-full bg-blue px-3 py-1 text-xs font-semibold text-ink">
        Plata online cu cardul — în pregătire
      </p>
      <h2 class="mt-4 font-display text-xl font-bold text-ink">Așa va arăta donația cu cardul</h2>
      <p class="mt-2 max-w-xl text-sm leading-relaxed text-ink-soft">
        Lucrăm la integrarea unui procesator de plăți pentru donații recurente și punctuale cu cardul. Sumele de mai
        jos sunt un exemplu — nu sunt încă funcționale.
      </p>
      <ul class="mt-5 flex flex-wrap gap-2.5" aria-hidden="true">
        {
          donations.suggestedAmounts.map((amount) => (
            <li class="rounded-full border border-ink/20 px-4 py-2 text-sm font-semibold text-ink/50">{amount} lei</li>
          ))
        }
      </ul>
      <Button href="#alternative" variant="dark" size="md" class="mt-5 pointer-events-none opacity-50" aria-disabled="true">
        Continuă către plată — indisponibil momentan
      </Button>
      <!-- TODO(payment-provider): wire up a real checkout (e.g. Stripe / Netopia / EuPlătesc) here.
           `donations.provider` in src/data/config.ts stays null until a processor is selected. -->
    </div>

    <div id="alternative" class="mt-10 scroll-mt-24 rounded-2xl border border-ink/10 bg-paper p-7">
      <h2 class="font-display text-xl font-bold text-ink">Poți dona acum, prin transfer bancar</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-soft">Transferă direct în contul asociației, indicând „Donație” la detalii.</p>

      <dl class="mt-5 grid gap-4 sm:grid-cols-[auto_1fr] sm:gap-x-8">
        <dt class="text-xs font-semibold uppercase tracking-wide text-ink-soft sm:self-center">Titular</dt>
        <dd class="text-sm text-ink">{contact.bankName}</dd>
        <dt class="text-xs font-semibold uppercase tracking-wide text-ink-soft sm:self-center">IBAN</dt>
        <dd class="flex flex-wrap items-center gap-3">
          <code class="rounded-lg bg-ink/5 px-3 py-1.5 text-sm text-ink" data-iban>{contact.bankAccount}</code>
          <button type="button" class="inline-flex items-center gap-1.5 text-sm font-semibold text-green hover:text-green-dark" data-copy-iban>
            <Icon name="check" class="h-4 w-4" data-copy-icon hidden />
            <span data-copy-label>Copiază</span>
          </button>
        </dd>
      </dl>
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t border-ink/10 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-sm text-sm leading-relaxed text-ink-soft">
        Nu costă nimic din buzunar: poți redirecționa 3,5% din impozitul pe venit către asociație.
      </p>
      <Button href={redirect230.url} variant="outline" size="md" external>
        Redirecționează 3,5%
        <Icon name="arrow-right" class="h-4 w-4" />
      </Button>
    </div>
  </section>
</PageLayout>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-copy-iban]");
  const iban = document.querySelector<HTMLElement>("[data-iban]");
  const label = document.querySelector<HTMLElement>("[data-copy-label]");
  const icon = document.querySelector<HTMLElement>("[data-copy-icon]");

  button?.addEventListener("click", async () => {
    if (!iban) return;
    try {
      await navigator.clipboard.writeText(iban.textContent?.trim() ?? "");
      if (label) label.textContent = "Copiat";
      icon?.removeAttribute("hidden");
      setTimeout(() => {
        if (label) label.textContent = "Copiază";
        icon?.setAttribute("hidden", "");
      }, 2000);
    } catch {
      // Clipboard API unavailable — the IBAN is already selectable text.
    }
  });
</script>
