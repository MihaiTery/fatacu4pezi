---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import StatusPill from "./StatusPill.astro";
import Icon from "./Icon.astro";
import { withBase } from "../lib/url";
import { speciesIconName } from "../lib/animals";

interface Props {
  animal: CollectionEntry<"animals">;
}

const { animal } = Astro.props;
const a = animal.data;
const sexLabel = a.sex === "mascul" ? "Mascul" : "Femelă";
// Cards for animals with an Instagram post open that post (new tab) —
// that's where the association keeps each case's photos, updates and
// comments; the rest still open their on-site profile.
const external = Boolean(a.instagram);
const href = a.instagram ?? withBase(`/adopta/${animal.id}`);
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  aria-label={external ? `${a.name} — vezi postarea pe Instagram (se deschide într-o filă nouă)` : undefined}
  class="card-lift group flex flex-col overflow-hidden rounded-2xl border border-ink/10 bg-paper transition-colors hover:border-ink/30"
>
  <div class="relative aspect-[4/3] overflow-hidden">
    <Image
      src={a.photo}
      alt={a.photoAlt}
      width={400}
      height={300}
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
    />
    <StatusPill status={a.status} adoptable={a.adoptable} class="absolute left-3 top-3 shadow-sm" />
  </div>
  <div class="flex flex-1 flex-col gap-2.5 p-5">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-display text-xl font-bold text-ink">{a.name}</h3>
      <Icon name={speciesIconName(a.species)} class="mt-1 h-5 w-5 shrink-0 text-ink/40" />
    </div>
    <p class="text-sm text-ink-soft">{a.ageLabel} · {sexLabel}{a.size ? ` · talie ${a.size}` : ""}</p>
    <ul class="mt-auto flex flex-wrap gap-1.5 pt-1">
      {
        a.personality.slice(0, 3).map((trait) => (
          <li class="rounded-full bg-ink/5 px-2.5 py-1 text-xs text-ink-soft">{trait}</li>
        ))
      }
    </ul>
    {
      external && (
        <p class="flex items-center gap-1.5 border-t border-ink/10 pt-3 text-sm font-semibold text-ink/80 group-hover:text-ink">
          Vezi pe Instagram
          <Icon name="external" class="h-4 w-4" />
        </p>
      )
    }
  </div>
</a>
