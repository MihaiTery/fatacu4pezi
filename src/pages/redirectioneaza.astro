---
import PageLayout from "../layouts/PageLayout.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import { redirect230 } from "../data/config";
import { withBase } from "../lib/url";

const steps = [
  {
    title: "Nu costă nimic în plus",
    text: "3,5% din impozitul pe venit merge oricum la stat — tu decizi doar cine îl primește: statul sau o cauză precum a noastră.",
  },
  {
    title: "Completezi Formularul 230",
    text: "Online, în câteva minute, prin platforma formular230.ro — sau descarci și trimiți formularul tipărit.",
  },
  {
    title: "Se aplică anual",
    text: "Redirecționarea este valabilă pentru anul fiscal la care se referă formularul — poți repeta gestul în fiecare an.",
  },
];
---

<PageLayout
  title="Redirecționează 3,5%"
  description="Redirecționează 3,5% din impozitul pe venit către Asociația Fata cu 4pezi, prin Formularul 230 — fără niciun cost suplimentar."
  intro="Poți susține asociația fără să scoți niciun ban din buzunar — redirecționând 3,5% din impozitul pe venit, prin Formularul 230."
>
  <section class="mx-auto max-w-3xl px-4 pb-20 pt-2 sm:px-6 lg:px-8">
    <ol class="flex flex-col gap-6">
      {
        steps.map((step, i) => (
          <li class="flex gap-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-green font-display text-sm font-bold text-cream">
              {i + 1}
            </span>
            <div>
              <p class="font-semibold text-ink">{step.title}</p>
              <p class="mt-1 text-sm leading-relaxed text-ink-soft">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="mt-10 rounded-2xl border border-ink/10 bg-paper p-7">
      <h2 class="font-display text-lg font-bold text-ink">Completează formularul</h2>
      <p class="mt-2 max-w-xl text-sm leading-relaxed text-ink-soft">
        Te redirecționăm către formular230.ro, platforma dedicată acestui proces. Ai nevoie doar de datele tale
        fiscale de bază.
      </p>
      <Button href={redirect230.url} variant="primary" size="lg" class="mt-5" external>
        Mergi la formular230.ro
        <Icon name="external" class="h-4 w-4" />
      </Button>
      <p class="mt-3 text-xs text-ink-soft">{redirect230.deadlineNote}</p>
    </div>

    <p class="mt-8 text-sm leading-relaxed text-ink-soft">
      Preferi să susții direct, printr-o sumă punctuală? Poți face asta din pagina de{" "}
      <a href={withBase("/doneaza")} class="font-semibold text-ink underline decoration-ink/30 hover:decoration-ink">donații</a>.
    </p>
  </section>
</PageLayout>
