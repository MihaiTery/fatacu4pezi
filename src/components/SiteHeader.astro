---
import Logo from "./Logo.astro";
import Button from "./Button.astro";
import SocialBadge from "./SocialBadge.astro";
import Icon from "./Icon.astro";
import { nav } from "../data/config";
import { withBase } from "../lib/url";

const currentPath = Astro.url.pathname;
// Astro.url.pathname includes the deploy base ("/fatacu4pezi/adopta"), so
// the comparison target needs the same prefix — comparing against the bare
// config href would never match once a base path is configured.
const isActive = (href: string) => {
  const target = withBase(href);
  return href === "/" ? currentPath === target : currentPath.startsWith(target);
};
---

<header class="sticky top-0 z-40">
  <!-- Transparent: no fill of its own, so it reads as a light utility row
       floating above the solid nav bar rather than one undifferentiated
       pink block. Whatever the page shows behind it (almost always cream)
       shows through. -->
  <div class="border-b border-ink/10">
    <div class="mx-auto flex max-w-7xl items-center justify-end px-4 py-1.5 sm:px-6 lg:px-8">
      <SocialBadge tone="ink" />
    </div>
  </div>

  <div class="bg-pink text-ink">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2.5 sm:px-6 lg:px-8">
      <a href={withBase("/")} class="flex shrink-0 items-center gap-2" aria-label="Fata cu 4pezi — acasă">
        <span class="flex aspect-square h-[5.6rem] shrink-0 items-center justify-center rounded-full border border-ink/10 bg-cream p-2.5 sm:h-[6.4rem]">
          <Logo variant="maro" class="h-full w-full object-contain" priority />
        </span>
      </a>

      <nav class="hidden items-center gap-6 lg:flex" aria-label="Navigație principală">
        {
          nav.slice(0, 6).map((item) => (
            <a
              href={withBase(item.href)}
              class={`text-[0.95rem] font-medium transition-colors hover:text-ink ${
                isActive(item.href) ? "text-ink underline decoration-2 underline-offset-8" : "text-ink/70"
              }`}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="hidden items-center gap-2.5 lg:flex">
        <Button href="#newsletter" variant="outline" size="sm">Newsletter</Button>
        <Button href="/redirectioneaza" variant="accent" size="sm">
          Redirecționează 3,5%
        </Button>
        <Button href="/doneaza" variant="primary" size="sm">Donează</Button>
      </div>

      <button
        type="button"
        class="flex items-center justify-center rounded-full border border-ink/25 p-2.5 text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="sr-only">Deschide meniul</span>
        <Icon name="menu" class="h-5 w-5" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-ink/10 bg-pink lg:hidden" data-menu-panel>
    <nav class="mx-auto flex max-w-7xl flex-col gap-1 px-4 py-4 sm:px-6" aria-label="Navigație mobilă">
      {
        nav.map((item) => (
          <a
            href={withBase(item.href)}
            class={`rounded-lg px-3 py-2.5 text-[0.95rem] font-medium ${
              isActive(item.href) ? "bg-ink/10 text-ink" : "text-ink/80 hover:bg-ink/5"
            }`}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <div class="mt-3 flex flex-col gap-2.5 border-t border-ink/10 pt-4">
        <Button href="/doneaza" variant="primary" size="md">Donează</Button>
        <Button href="/redirectioneaza" variant="accent" size="md">
          Redirecționează 3,5%
        </Button>
        <Button href="#newsletter" variant="outline" size="md">Newsletter</Button>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    panel?.classList.toggle("hidden", isOpen);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      toggle.setAttribute("aria-expanded", "false");
      panel?.classList.add("hidden");
      toggle.focus();
    }
  });

  // A link to another page reloads and closes the panel implicitly. An
  // in-page anchor (the newsletter box) doesn't, so every panel link gets
  // an explicit close on click.
  panel?.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
    link.addEventListener("click", () => {
      toggle?.setAttribute("aria-expanded", "false");
      panel.classList.add("hidden");
    });
  });
</script>
