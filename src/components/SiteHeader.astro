---
import Logo from "./Logo.astro";
import Button from "./Button.astro";
import SocialBadge from "./SocialBadge.astro";
import Icon from "./Icon.astro";
import { nav, redirect230 } from "../data/config";
import { withBase } from "../lib/url";

const currentPath = Astro.url.pathname;
// Astro.url.pathname includes the deploy base ("/fatacu4pezi/adopta"), so
// the comparison target needs the same prefix — comparing against the bare
// config href would never match once a base path is configured.
const isActive = (href: string) => {
  const target = withBase(href);
  return href === "/" ? currentPath === target : currentPath.startsWith(target);
};
---

<header class="sticky top-0 z-40">
  <!-- Transparent: no fill of its own, so it reads as a light utility row
       floating above the solid nav bar rather than one undifferentiated
       green block. Whatever the page shows behind it (almost always cream)
       shows through. -->
  <div class="border-b border-ink/10">
    <div class="mx-auto flex max-w-7xl items-center justify-end px-4 py-1.5 sm:px-6 lg:px-8">
      <SocialBadge tone="ink" />
    </div>
  </div>

  <div class="bg-mark-invert bg-green text-cream">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2.5 sm:px-6 lg:px-8">
      <a href={withBase("/")} class="flex shrink-0 items-center gap-2" aria-label="Fata cu 4pezi — acasă">
        <span class="flex aspect-square h-[5.6rem] shrink-0 items-center justify-center rounded-full bg-cream p-2.5 sm:h-[6.4rem]">
          <Logo variant="maro" class="h-full w-full object-contain" priority />
        </span>
      </a>

      <nav class="hidden items-center gap-6 lg:flex" aria-label="Navigație principală">
        {
          nav.slice(0, 6).map((item) => (
            <a
              href={withBase(item.href)}
              class={`text-[0.95rem] font-medium transition-colors hover:text-cream ${
                isActive(item.href) ? "text-cream underline decoration-2 underline-offset-8" : "text-cream/80"
              }`}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="hidden items-center gap-2.5 lg:flex">
        <Button href={redirect230.url} variant="outline-light" size="sm" external>
          Redirecționează 3,5%
        </Button>
        <Button href="/doneaza" variant="cream" size="sm">Donează</Button>
      </div>

      <button
        type="button"
        class="flex items-center justify-center rounded-full border border-cream/30 p-2.5 text-cream lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="sr-only">Deschide meniul</span>
        <Icon name="menu" class="h-5 w-5" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-cream/15 bg-mark-invert bg-green lg:hidden" data-menu-panel>
    <nav class="mx-auto flex max-w-7xl flex-col gap-1 px-4 py-4 sm:px-6" aria-label="Navigație mobilă">
      {
        nav.map((item) => (
          <a
            href={withBase(item.href)}
            class={`rounded-lg px-3 py-2.5 text-[0.95rem] font-medium ${
              isActive(item.href) ? "bg-cream/15 text-cream" : "text-cream/85 hover:bg-cream/10"
            }`}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <div class="mt-3 flex flex-col gap-2.5 border-t border-cream/15 pt-4">
        <Button href="/doneaza" variant="cream" size="md">Donează</Button>
        <Button href={redirect230.url} variant="outline-light" size="md" external>
          Redirecționează 3,5%
        </Button>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    panel?.classList.toggle("hidden", isOpen);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      toggle.setAttribute("aria-expanded", "false");
      panel?.classList.add("hidden");
      toggle.focus();
    }
  });
</script>
