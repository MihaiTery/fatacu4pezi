---
import PageLayout from "../layouts/PageLayout.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
---

<PageLayout
  title="Magazinul Fata cu 4pezi"
  seoTitle="Magazinul Fata cu 4pezi | În curând"
  description="Pregătim magazinul Fata cu 4pezi. Descoperă cum vei putea susține activitatea asociației prin produsele disponibile după lansare."
  noindex
>
  <section class="bg-animals mt-6 border-t border-ink/10 px-4 py-16 sm:px-6 sm:py-24 lg:px-8 [--animals-ink:var(--color-green)] [--animals-size:320px]">
    <div class="mx-auto max-w-2xl rounded-2xl border-2 border-dashed border-ink/25 bg-paper p-10 text-center">
      <p class="inline-flex items-center gap-2 rounded-full bg-blue px-3 py-1 text-xs font-semibold text-ink">În curând</p>
      <p class="mt-5 text-ink-soft">
        Pregătim un magazin prin care vei putea susține activitatea asociației. Vom publica aici produsele și informațiile despre
        modul în care contribuie la sprijinirea animalelor.
      </p>
      <Button href="/doneaza" variant="primary" size="md" class="mt-6">
        Descoperă cum poți ajuta acum
        <Icon name="arrow-right" class="h-4 w-4" />
      </Button>
    </div>
  </section>
</PageLayout>
