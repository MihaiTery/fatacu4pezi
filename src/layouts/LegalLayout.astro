---
// Shared shell for the legal/informational pages (confidențialitate,
// cookies, termeni, informații legale): PageLayout's H1 + intro, a
// "Ultima actualizare" line, an optional table of contents, and the prose
// styles capped at a readable measure. The copy itself lives in each page.
import PageLayout from "./PageLayout.astro";
import { legalLastUpdated } from "../data/config";

interface Props {
  title: string;
  seoTitle: string;
  description: string;
  intro?: string;
  toc?: { id: string; label: string }[];
  showUpdated?: boolean;
}

const { title, seoTitle, description, intro, toc, showUpdated = true } = Astro.props;
---

<PageLayout title={title} seoTitle={seoTitle} description={description} intro={intro}>
  <section class="mx-auto max-w-7xl px-4 pb-20 pt-2 sm:px-6 lg:px-8">
    {showUpdated && <p class="text-sm text-ink-soft">Ultima actualizare: {legalLastUpdated}</p>}

    {
      toc && toc.length > 0 && (
        <nav aria-labelledby="toc-heading" class="mt-8 max-w-prose rounded-2xl border border-ink/10 bg-paper p-6">
          <h2 id="toc-heading" class="font-display text-base font-bold text-ink">
            Cuprins
          </h2>
          <ol class="mt-3 flex list-decimal flex-col gap-1.5 pl-5 text-[0.95rem] marker:text-ink-soft">
            {toc.map((item) => (
              <li>
                <a href={`#${item.id}`} class="text-ink underline decoration-ink/30 underline-offset-2 hover:decoration-ink">
                  {item.label}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="legal-prose prose-fatacu mt-10 max-w-prose text-ink-soft">
      <slot />
    </div>
  </section>
</PageLayout>

<style>
  /* Anchor targets land below the sticky header instead of under it. */
  .legal-prose :global(h2),
  .legal-prose :global(h3) {
    scroll-margin-top: 11rem;
  }
  .legal-prose :global(h2:first-child) {
    margin-top: 0;
  }
  .legal-prose :global(dl) {
    display: grid;
    gap: 0.25rem 1.5rem;
  }
  .legal-prose :global(dt) {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }
  .legal-prose :global(dd) {
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }
  @media (min-width: 640px) {
    .legal-prose :global(dl) {
      grid-template-columns: minmax(9rem, auto) 1fr;
      align-items: baseline;
    }
    .legal-prose :global(dt) {
      margin-top: 0.5rem;
    }
    .legal-prose :global(dd) {
      margin-top: 0.5rem;
    }
  }
  .legal-prose :global(.note) {
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
    background: var(--color-paper);
    padding: 1.25rem 1.5rem;
  }
</style>
