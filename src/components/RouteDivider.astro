---
// A quiet rhythm mark between sections — never decoration for its own sake.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class={`flex items-center gap-3 ${className ?? ""}`} role="presentation" aria-hidden="true">
  <span class="h-2 w-2 shrink-0 rounded-full bg-ink/25"></span>
  <span class="route-line flex-1"></span>
  <span class="h-2 w-2 shrink-0 rounded-full bg-ink/25"></span>
</div>
