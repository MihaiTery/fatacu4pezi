---
import PageLayout from "../layouts/PageLayout.astro";
import RouteJourney from "../components/RouteJourney.astro";
import RouteDivider from "../components/RouteDivider.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";

const principles = [
  {
    title: "Fiecare animal contează",
    text: "Ne preocupă animalele aflate în dificultate, indiferent de specie, vârstă sau de câtă atenție primește cazul lor.",
  },
  {
    title: "Îngrijire adaptată fiecărui caz",
    text: "Tratamentul, recuperarea și măsurile de prevenție trebuie adaptate speciei, vârstei și stării de sănătate, cu sprijin de specialitate atunci când este necesar.",
  },
  {
    title: "Adopții responsabile",
    text: "Ne dorim ca animalele să ajungă în familii pregătite să le respecte nevoile și să își asume îngrijirea lor pe termen lung.",
  },
  {
    title: "Colaborare și transparență",
    text: "Credem în sprijinul oferit împreună cu voluntarii și partenerii și în comunicarea clară a informațiilor verificate despre activitatea asociației.",
  },
];
---

<PageLayout
  title="Despre Fata cu 4pezi"
  seoTitle="Despre noi și misiunea asociației | Fata cu 4pezi"
  description="Cunoaște Asociația Fata cu 4pezi. Salvăm animale de toate speciile din București și Ilfov și căutăm soluții de îngrijire și adopție responsabilă."
  intro="Suntem o asociație dedicată animalelor aflate în dificultate. Intervenim pentru salvarea lor și căutăm soluții potrivite de îngrijire și adopție, indiferent de specie."
>
  <section class="mx-auto max-w-3xl px-4 py-4 sm:px-6 lg:px-8">
    <div class="space-y-5 text-lg leading-relaxed text-ink-soft" data-reveal>
      <p>
        Un animal abandonat, rănit sau aflat în pericol are nevoie de mai mult decât o intervenție de moment. Are nevoie de îngrijire, de timp
        pentru recuperare și de oameni care să se preocupe de ceea ce urmează.
      </p>
      <p>
        La Fata cu 4pezi, ne concentrăm pe salvarea animalelor din București și Ilfov. În funcție de nevoile fiecărui caz, căutăm soluții pentru
        evaluare și tratament veterinar, recuperare, hrană și găzduire temporară. Colaborarea cu voluntarii și partenerii ne ajută să oferim sprijin
        acolo unde este nevoie.
      </p>
      <p>
        Nu ne limităm la câini și pisici. Misiunea noastră privește animalele de toate speciile. Atunci când adopția este posibilă și potrivită,
        căutăm familii responsabile. În situațiile care necesită îngrijire specializată sau în care adopția nu este permisă, urmărim identificarea
        unei soluții adecvate pentru animal.
      </p>
    </div>
  </section>

  <section class="alt-band border-y border-ink/10 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <RouteDivider class="mb-12" />
      <div data-reveal>
        <h2 class="font-display text-2xl font-bold text-ink sm:text-3xl">Cum ajutăm un animal, pas cu pas</h2>
        <p class="mt-2 max-w-2xl text-ink-soft">Fiecare caz este diferit. Aceștia sunt pașii care ne ghidează atunci când un animal are nevoie de ajutor.</p>
      </div>
      <div class="mt-10">
        <RouteJourney />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <RouteDivider class="mb-12" />
    <h2 class="font-display text-2xl font-bold text-ink sm:text-3xl" data-reveal>Ce ne ghidează</h2>
    <dl class="mt-8 grid gap-x-10 gap-y-9 sm:grid-cols-2">
      {
        principles.map((p) => (
          <div>
            <dt class="flex items-center gap-2.5 font-display font-bold text-ink">
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-green" aria-hidden="true" />
              {p.title}
            </dt>
            <dd class="mt-2 pl-4 text-sm leading-relaxed text-ink-soft">{p.text}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-20 sm:px-6 lg:px-8">
    <div class="flex flex-wrap gap-3 border-t border-ink/10 pt-10">
      <Button href="/parteneri" variant="outline">
        Rețeaua de parteneri
        <Icon name="arrow-right" class="h-4 w-4" />
      </Button>
      <Button href="/transparenta" variant="outline">
        Transparență
        <Icon name="arrow-right" class="h-4 w-4" />
      </Button>
    </div>
  </section>
</PageLayout>
