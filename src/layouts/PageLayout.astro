---
import Layout from "./Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  // Full SEO <title> — see Layout.astro. `title` itself keeps driving the H1
  // below regardless of whether this is set.
  seoTitle?: string;
  description: string;
  image?: string;
  intro?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
}

const { title, seoTitle, description, image, intro, noindex, ogType } = Astro.props;
---

<Layout title={title} seoTitle={seoTitle} description={description} image={image} noindex={noindex} ogType={ogType}>
  <div class="flex min-h-screen flex-col">
    <SiteHeader />
    <main id="main" class="flex-1">
      <div class="mx-auto max-w-7xl px-4 pb-4 pt-10 sm:px-6 sm:pt-14 lg:px-8">
        <h1 class="max-w-3xl font-display text-4xl font-bold text-ink sm:text-5xl">{title}</h1>
        {intro && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">{intro}</p>}
      </div>
      <slot />
    </main>
    <SiteFooter />
  </div>
</Layout>
